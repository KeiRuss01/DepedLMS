# Copy this file to .env on the server and replace every example value.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
DJANGO_TIME_ZONE=Asia/Manila

DB_ENGINE=django.db.backends.mysql
DB_NAME=yourusername$lms_db
DB_USER=yourusername
DB_PASSWORD=replace-with-your-database-password
DB_HOST=yourusername.mysql.pythonanywhere-services.com
DB_PORT=3306

# Start with one hour. Increase only after HTTPS is confirmed working.
DJANGO_HSTS_SECONDS=3600

# Folder outside the public static/media directories for protected module files.
PRIVATE_LEARNING_ROOT=/home/yourusername/DepedLMS-private

# Email verification (Gmail requires a 16-character App Password.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=n1.hybrid.hlms@gmail.com
